# ============================================
# LocalAI Bridge — Environment Configuration
# ============================================

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://localai:localai_secret@localhost:5432/localai_bridge
POSTGRES_DB=localai_bridge
POSTGRES_USER=localai
POSTGRES_PASSWORD=localai_secret

# Security
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-to-a-secure-admin-secret
DEVICE_SECRET=change-me-to-a-secure-device-secret

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Request Timeout (ms)
REQUEST_TIMEOUT_MS=120000

# Heartbeat
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=10000
